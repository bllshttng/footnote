# Claude Code temp files
.claude/*.local.md
.claude/audit-progress.txt
.claude/plans
.claude/scheduled_tasks.lock
.claude/scheduled_tasks.json
.claude/worktrees/

# Top-level scratch plans are personal/working specs (the canonical plans live
# in the Obsidian vault under internal/). Keep them out of the public tree so
# they cannot leak machine paths or private project names. Anchored to root so
# internal/**/plans and .claude/plans are unaffected.
/plans/

# Ignore auto-generated folder context files
**/CLAUDE.md

# But keep the root CLAUDE.md if you want
!/CLAUDE.md

# OS files
.DS_Store
**/.DS_Store

# Node modules
node_modules/

# Python
__pycache__/
**/__pycache__/
*.pyc
*.pyo

# Runtime state (planning/execution)
.fno/
**/.fno/
# In worktrees .fno is a SYMLINK to canonical; the dir-only patterns above miss
# it, so `git add -A` would stage it. Ignore the symlink form too.
.fno
**/.fno
# But track the example config file - it is documentation, not runtime state
!.fno/settings.yaml.example
!**/.fno/settings.yaml.example
# The ambient-poison fixture is a synthetic .fno tree checked in on purpose: it
# is what `fno test smoke --ambient dirty` feeds the runner, so it has to travel
# with the repo rather than be reconstructed on each machine.
!cli/tests/fixtures/ambient-poison/**/.fno/
!cli/tests/fixtures/ambient-poison/**/.fno/**

# Logs
*.log
**/*.log

# Cache
.cache/

# Other provider configs (local, not distributed).
# NB: .codex-plugin/ is intentionally NOT here - it's the public Codex plugin
# manifest (parity with .claude-plugin/), so it must ship.
.agents/*
!.agents/plugins/
!.agents/plugins/marketplace.json
.codex/*
!.codex/agents/
!.codex/agents/*.toml
# No trailing slash: setup-worktree.sh link_dir's this one into a SYMLINK, and a
# `foo/` rule matches directories only, so the slash form left every linked
# worktree dirty and preflight refusing (same defect as the .claude/* links
# below). .agents/.codex/.codex-plugin keep their glob form on purpose: each
# holds tracked files, so link_dir hits its non-empty-real-dir refusal and they
# are never symlinks - and .codex-plugin must stay shippable besides.
.gemini

# Private/local scripts and docs (environment-specific, not for distribution)
**/local/

# Symlinks to private vaults/repos
internal

# Abilities feels
.fno/feels/observations.jsonl
.fno/feels/observations.archive/
.fno/feels/.usage-data-watermark

# CLI package build artifacts
cli/dist/
cli/.venv/

# managed by link-skills.py. NO trailing slash: setup-worktree.sh links these
# as SYMLINKS into the canonical checkout, and a trailing-slash pattern matches
# directories only - so a `foo/` rule leaves the symlink untracked, every linked
# worktree reads dirty, and scripts/ci/preflight.sh refuses to run (it validates
# a committed HEAD). Without the slash the rule matches both shapes.
.claude/skills
.claude/commands
.claude/agents
.claude/.skill-scoping-state.json
# local runtime hook logs (never commit)
.claude/hooks/
# Same, nested: skill-scoping drops .claude/hooks/ inside subpackages (cli/, crates/...)
**/.claude/hooks/

# Persisted Workflow-tool scripts (local run artifacts, regenerated on demand)
.claude/workflows/

# Impeccable skill hook caches (any depth)
**/.impeccable/

# Conductor local workspace state
.conductor/

# understand-anything skill output (generated knowledge graph; keep local, never commit)
.understand-anything/

# Local secrets (z.ai / model-routing keys, etc.) - never commit
.env

# Coverage runs land here; never a commit candidate
.coverage

# Scratch diffs staged by /review peer for a sandboxed model to read locally.
# Untracked they are one `git add -A` from a 100KB+ junk commit, and they block
# archive-worktree on an otherwise-clean merged tree.
peer-review.tmp.diff
peer-review.diff
