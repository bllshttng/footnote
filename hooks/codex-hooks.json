{
  "description": "Codex plugin hooks for footnote context injection, safety gates, and target loops",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${PLUGIN_ROOT}/hooks/graph-write-protect.sh",
            "statusMessage": "checking fno do state surfaces"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${PLUGIN_ROOT}/hooks/worktree-write-protect.sh",
            "statusMessage": "checking worktree location"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${PLUGIN_ROOT}/hooks/generated-write-guard.sh",
            "statusMessage": "checking generated copies"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${PLUGIN_ROOT}/hooks/plan-location-guard.sh",
            "statusMessage": "checking plan save location"
          }
        ]
      },
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${PLUGIN_ROOT}/hooks/git-protection.py",
            "statusMessage": "checking git guardrails"
          },
          {
            "type": "command",
            "command": "python3 ${PLUGIN_ROOT}/hooks/bg-process-guard.py",
            "statusMessage": "checking for unbounded background processes"
          },
          {
            "type": "command",
            "command": "bash ${PLUGIN_ROOT}/hooks/pipe-guard.sh",
            "statusMessage": "checking for a pipe that hides the exit or the rows"
          },
          {
            "type": "command",
            "command": "python3 ${PLUGIN_ROOT}/hooks/recursive-grep-guard.py",
            "statusMessage": "checking recursive grep cache traversal"
          },
          {
            "type": "command",
            "command": "bash ${PLUGIN_ROOT}/hooks/test-run-guard.sh",
            "statusMessage": "checking for an unadmitted raw test run"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/hooks/law-stage-inject.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/hooks/inside-leg-report.sh working"
          },
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/hooks/born-with-why-offer-inject.sh"
          },
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/hooks/inject-mail-notify.sh"
          },
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/hooks/inject-announce.sh prompt"
          },
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/hooks/prompt-outstanding.sh",
            "timeout": 2
          },
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/hooks/law-stage-inject.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${PLUGIN_ROOT}/hooks/code-review-attest.sh"
          },
          {
            "type": "command",
            "command": "bash ${PLUGIN_ROOT}/hooks/codex-review-findings.sh"
          },
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/hooks/target-stop-hook.sh"
          },
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/hooks/inside-leg-report.sh done"
          },
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/hooks/context-nudge.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${PLUGIN_ROOT}/hooks/format-on-edit.sh",
            "statusMessage": "formatting the edited file"
          },
          {
            "type": "command",
            "command": "bash ${PLUGIN_ROOT}/hooks/edit-integrity.sh",
            "statusMessage": "checking the edited file",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node ${PLUGIN_ROOT}/hooks/spend-drift-monitor.js"
          },
          {
            "type": "command",
            "command": "bash ${PLUGIN_ROOT}/hooks/claim-heartbeat.sh"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/hooks/target-subagent-guard.sh"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/hooks/target-subagent-guard.sh"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${PLUGIN_ROOT}/scripts/save-session.py"
          },
          {
            "type": "command",
            "command": "env FNO_PLATFORM=codex ${PLUGIN_ROOT}/hooks/precompact-canon-doc.sh"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "env FNO_PLATFORM=codex ${PLUGIN_ROOT}/hooks/context-run.sh codex-post-compact"
          },
          {
            "type": "command",
            "command": "env FNO_PLATFORM=codex ${PLUGIN_ROOT}/hooks/inject-announce.sh compact"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "env FNO_PLATFORM=codex ${PLUGIN_ROOT}/hooks/context-run.sh codex-session-start"
          },
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/hooks/codex-app-server-nudge-session-start.sh"
          },
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/hooks/operator-capture-nudge.sh"
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "env FNO_PLATFORM=codex ${PLUGIN_ROOT}/hooks/context-run.sh codex-whoami"
          }
        ]
      }
    ]
  }
}
