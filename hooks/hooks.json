{
  "description": "Abilities plugin hooks for target loops, context monitoring, and project context injection",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/graph-write-protect.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/worktree-write-protect.sh"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/plan-location-guard.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/git-protection.py"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/inside-leg-report.sh working"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/born-with-why-offer-inject.sh"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/inject-mail-notify.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/target-stop-hook.sh"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/king-context-nudge.sh"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/inside-leg-report.sh done"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/target-stopfailure.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/context-monitor.js"
          },
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/claim-heartbeat.sh"
          }
        ]
      },
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/capture-plan-mode.sh"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/target-subagent-guard.sh"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/target-subagent-guard.sh"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/save-session.py"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/arm-handoff-precompact.sh"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/context-observe-hook.sh --source-id target-postcompact-reinject --expected target-postcompact-reinject --entry post_compact -- ${CLAUDE_PLUGIN_ROOT}/hooks/target-postcompact-reinject.sh"
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/worktree-setup.sh",
            "timeout": 120000
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/worktree-remove.sh"
          }
        ]
      }
    ],
    "CwdChanged": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/worktree-env-reload.sh"
          }
        ]
      }
    ],
    "FileChanged": [
      {
        "matcher": ".env|.env.local|.env.development|.env.development.local|.envrc",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/worktree-env-reload.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/scripts/save-session.py"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/context-observe-hook.sh --source-id using-fno --expected using-fno,inject-project-vision,setup-nudge-session-start,frontdoor-nudge-session-start,inject-fno-agent-whoami,worktree-peers-session-start,cache-keepalive-inject,register-session-start,inject-mail-drain-session-start,reconcile-session-start,attest-model,eval-sweep-session-start,groom-self-heal-session-start -- ${CLAUDE_PLUGIN_ROOT}/hooks/session-start-using-fno.sh"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/context-observe-hook.sh --source-id inject-project-vision --expected using-fno,inject-project-vision,setup-nudge-session-start,frontdoor-nudge-session-start,inject-fno-agent-whoami,worktree-peers-session-start,cache-keepalive-inject,register-session-start,inject-mail-drain-session-start,reconcile-session-start,attest-model,eval-sweep-session-start,groom-self-heal-session-start -- ${CLAUDE_PLUGIN_ROOT}/hooks/inject-project-vision.sh"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/context-observe-hook.sh --source-id setup-nudge-session-start --expected using-fno,inject-project-vision,setup-nudge-session-start,frontdoor-nudge-session-start,inject-fno-agent-whoami,worktree-peers-session-start,cache-keepalive-inject,register-session-start,inject-mail-drain-session-start,reconcile-session-start,attest-model,eval-sweep-session-start,groom-self-heal-session-start -- ${CLAUDE_PLUGIN_ROOT}/hooks/setup-nudge-session-start.sh"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/context-observe-hook.sh --source-id frontdoor-nudge-session-start --expected using-fno,inject-project-vision,setup-nudge-session-start,frontdoor-nudge-session-start,inject-fno-agent-whoami,worktree-peers-session-start,cache-keepalive-inject,register-session-start,inject-mail-drain-session-start,reconcile-session-start,attest-model,eval-sweep-session-start,groom-self-heal-session-start -- ${CLAUDE_PLUGIN_ROOT}/hooks/frontdoor-nudge-session-start.sh"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/context-observe-hook.sh --source-id inject-fno-agent-whoami --expected using-fno,inject-project-vision,setup-nudge-session-start,frontdoor-nudge-session-start,inject-fno-agent-whoami,worktree-peers-session-start,cache-keepalive-inject,register-session-start,inject-mail-drain-session-start,reconcile-session-start,attest-model,eval-sweep-session-start,groom-self-heal-session-start -- ${CLAUDE_PLUGIN_ROOT}/hooks/inject-fno-agent-whoami.sh"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/context-observe-hook.sh --source-id worktree-peers-session-start --expected using-fno,inject-project-vision,setup-nudge-session-start,frontdoor-nudge-session-start,inject-fno-agent-whoami,worktree-peers-session-start,cache-keepalive-inject,register-session-start,inject-mail-drain-session-start,reconcile-session-start,attest-model,eval-sweep-session-start,groom-self-heal-session-start -- ${CLAUDE_PLUGIN_ROOT}/hooks/worktree-peers-session-start.sh"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/context-observe-hook.sh --source-id cache-keepalive-inject --expected using-fno,inject-project-vision,setup-nudge-session-start,frontdoor-nudge-session-start,inject-fno-agent-whoami,worktree-peers-session-start,cache-keepalive-inject,register-session-start,inject-mail-drain-session-start,reconcile-session-start,attest-model,eval-sweep-session-start,groom-self-heal-session-start -- ${CLAUDE_PLUGIN_ROOT}/hooks/cache-keepalive-inject.sh"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/context-observe-hook.sh --source-id register-session-start --expected using-fno,inject-project-vision,setup-nudge-session-start,frontdoor-nudge-session-start,inject-fno-agent-whoami,worktree-peers-session-start,cache-keepalive-inject,register-session-start,inject-mail-drain-session-start,reconcile-session-start,attest-model,eval-sweep-session-start,groom-self-heal-session-start -- ${CLAUDE_PLUGIN_ROOT}/hooks/register-session-start.sh"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/context-observe-hook.sh --source-id inject-mail-drain-session-start --expected using-fno,inject-project-vision,setup-nudge-session-start,frontdoor-nudge-session-start,inject-fno-agent-whoami,worktree-peers-session-start,cache-keepalive-inject,register-session-start,inject-mail-drain-session-start,reconcile-session-start,attest-model,eval-sweep-session-start,groom-self-heal-session-start -- ${CLAUDE_PLUGIN_ROOT}/hooks/inject-mail-drain-session-start.sh"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/context-observe-hook.sh --source-id reconcile-session-start --expected using-fno,inject-project-vision,setup-nudge-session-start,frontdoor-nudge-session-start,inject-fno-agent-whoami,worktree-peers-session-start,cache-keepalive-inject,register-session-start,inject-mail-drain-session-start,reconcile-session-start,attest-model,eval-sweep-session-start,groom-self-heal-session-start -- ${CLAUDE_PLUGIN_ROOT}/hooks/reconcile-session-start.sh"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/context-observe-hook.sh --source-id attest-model --expected using-fno,inject-project-vision,setup-nudge-session-start,frontdoor-nudge-session-start,inject-fno-agent-whoami,worktree-peers-session-start,cache-keepalive-inject,register-session-start,inject-mail-drain-session-start,reconcile-session-start,attest-model,eval-sweep-session-start,groom-self-heal-session-start -- ${CLAUDE_PLUGIN_ROOT}/hooks/attest-model.sh"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/context-observe-hook.sh --source-id eval-sweep-session-start --expected using-fno,inject-project-vision,setup-nudge-session-start,frontdoor-nudge-session-start,inject-fno-agent-whoami,worktree-peers-session-start,cache-keepalive-inject,register-session-start,inject-mail-drain-session-start,reconcile-session-start,attest-model,eval-sweep-session-start,groom-self-heal-session-start -- ${CLAUDE_PLUGIN_ROOT}/hooks/eval-sweep-session-start.sh"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/context-observe-hook.sh --source-id groom-self-heal-session-start --expected using-fno,inject-project-vision,setup-nudge-session-start,frontdoor-nudge-session-start,inject-fno-agent-whoami,worktree-peers-session-start,cache-keepalive-inject,register-session-start,inject-mail-drain-session-start,reconcile-session-start,attest-model,eval-sweep-session-start,groom-self-heal-session-start -- ${CLAUDE_PLUGIN_ROOT}/hooks/groom-self-heal-session-start.sh"
          }
        ]
      }
    ]
  }
}
